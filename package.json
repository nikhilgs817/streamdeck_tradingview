{
  "name": "streamdeck-tradingview",
  "type": "module",
  "version": "1.0.1",
  "description": "Unofficial TradingView controls for Elgato Stream Deck on Windows",
  "scripts": {
    "build": "node tools/generate.mjs && rollup -c",
    "test": "node tools/test-workflows.mjs && node tools/test-trading-input.mjs",
    "test:ui": "node tools/test-companion-ui.mjs",
    "validate": "streamdeck validate plugins/tradingview/com.dailyops.tradingview.v1.sdPlugin",
    "pack": "node tools/clean.mjs && streamdeck pack plugins/tradingview/com.dailyops.tradingview.v1.sdPlugin --output dist --force",
    "preview": "node tools/render-app-preview.mjs",
    "test:input": "node tools/test-trading-input.mjs",
    "build:installer": "node tools/build-installer.mjs",
    "test:installer": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/test-installer.ps1"
  },
  "keywords": [],
  "author": "Daily Ops",
  "license": "MIT",
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@elgato/streamdeck": "^3.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "rollup": "npm:@rollup/wasm-node@^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "5.9"
  },
  "private": true
}
